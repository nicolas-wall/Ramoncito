// =============================================================
//  secrets.h.example — Plantilla de credenciales
//
//  INSTRUCCIONES:
//    1. Copiá este archivo a include/secrets.h
//         cp include/secrets.h.example include/secrets.h
//    2. Completá tus credenciales reales en secrets.h
//    3. secrets.h está en .gitignore y NUNCA debe subirse
//       al repositorio.
//
//  Este archivo (.example) sí se versiona: sirve como
//  referencia para otros colaboradores.
// =============================================================

#pragma once

// Red WiFi (opcional: normalmente Ramoncito la toma del portal cautivo,
//  no de acá; estas constantes quedan como referencia).
#define WIFI_SSID "tu-red"
#define WIFI_PASS "tu-clave"

// ----- Telegram (opcional) -------------------------------------
// Para que Ramoncito te escriba y vos le mandes mensajes/comandos.
//   1. Hablá con @BotFather en Telegram → /newbot → te da el TOKEN.
//   2. Hablá con @userinfobot → te dice tu CHAT ID (un número).
//   3. Pegá ambos acá abajo. Si el token queda vacío, Telegram se
//      desactiva solo (el resto del firmware anda igual).
#define TELEGRAM_BOT_TOKEN "123456789:AA-tu-token-de-botfather"
#define TELEGRAM_CHAT_ID   "111111111"

// ----- Webhook de notificaciones (opcional) --------------------
// Clave simple para el endpoint POST /api/notify (además del Basic Auth
// del panel). Dejala como quieras; vacío = no exige clave extra.
#define NOTIFY_TOKEN ""

// =============================================================
//  secrets.h.example — Plantilla de credenciales
//
//  INSTRUCCIONES:
//    1. Copiá este archivo a include/secrets.h
//         cp include/secrets.h.example include/secrets.h
//    2. Completá tus credenciales reales en secrets.h
//    3. secrets.h está en .gitignore y NUNCA debe subirse
//       al repositorio.
//
//  Este archivo (.example) sí se versiona: sirve como
//  referencia para otros colaboradores.
//
//  NOTA (0.11.0): con el pivot a arcade se retiraron Telegram y el
//  dashboard web, así que ya no hay tokens que configurar. El archivo
//  queda porque el firmware lo incluye si existe, y por si vuelve a
//  hacer falta algún secreto más adelante.
//
//  Si venís de una versión anterior, tu include/secrets.h local puede
//  seguir teniendo el token del bot. Ya no se compila dentro del binario
//  —telegram.cpp no existe más—, pero conviene borrarlo igual.
// =============================================================

#pragma once

// Red WiFi (opcional: normalmente el arcade la toma del portal cautivo,
//  no de acá; estas constantes quedan como referencia).
#define WIFI_SSID "tu-red"
#define WIFI_PASS "tu-clave"
